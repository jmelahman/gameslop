# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local planning artifacts
.playwright-mcp/
.tmp/

# Block all PNGs by default to keep dev/Playwright screenshots out of commits.
# Allowlist legit asset locations below; use `git add -f` for one-off exceptions.
*.png
!assets/*.png
.claude-tmp/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# release artifacts
/gameslop

# frontend
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/*.tsbuildinfo
