{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prek",
      "type": "shell",
      "command": "prek",
      "args": ["run", "--from-ref", "origin/master", "--to-ref", "HEAD"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "go",
      "args": ["test", "./..."],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Gameslop Backend",
      "type": "shell",
      "command": "go",
      "args": ["run", "."],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
